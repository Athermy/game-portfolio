---
import Layout from '../../../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const allDevlogs = await getCollection('devlogs');
  const games = await getCollection('games');

  return games.flatMap((game) => {
    const gameDevlogs = allDevlogs
      .filter((d) => d.data.game === game.id)
      .sort((a, b) => a.data.number - b.data.number); // chronological, for prev/next

    return gameDevlogs.map((log, index) => ({
      params: { id: game.id, number: String(log.data.number) },
      props: {
        game,
        log,
        prev: gameDevlogs[index - 1] ?? null,
        next: gameDevlogs[index + 1] ?? null,
      },
    }));
  });
}

const { game, log, prev, next } = Astro.props;
const { Content } = await render(log);
---

<Layout title={`${log.data.title} | ${game.data.title} Devlog`}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16 w-full">
    <a
      href={`/game-portfolio/games/${game.id}/`}
      class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-faint)] hover:text-[var(--accent)] transition-colors mb-8"
    >
      &larr; BACK TO {game.data.title.toUpperCase()}
    </a>

    <header class="border-b border-[var(--border)] pb-8 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="badge">#{log.data.number}</span>
        <span class="text-[11px] font-mono text-[var(--text-faint)]">Published {log.data.date}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-heading)] tracking-tight mb-4">{log.data.title}</h1>
      <p class="text-[var(--text-body)] text-base leading-relaxed font-light mb-5">{log.data.excerpt}</p>

      {log.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {log.data.tags.map((tag) => <span class="badge">{tag}</span>)}
        </div>
      )}
    </header>

    {log.data.coverImage && (
      <img src={log.data.coverImage} alt={log.data.title} class="w-full rounded-xl border border-[var(--border)] mb-10" />
    )}

    <div class="prose prose-invert max-w-2xl mx-auto
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--text-heading)] prose-strong:text-[var(--text-heading)] prose-strong:font-semibold prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline
      prose-h2:text-2xl prose-h2:border-b prose-h2:border-[var(--border)] prose-h2:pb-3 prose-h2:mt-10
      prose-h3:text-xl prose-h3:font-bold prose-h3:text-[var(--accent)] prose-h3:mt-10 prose-h3:mb-3
      prose-p:text-[var(--text-body)] prose-p:leading-relaxed
      prose-li:text-[var(--text-secondary)] prose-ul:list-disc prose-ol:list-decimal
      prose-img:rounded-lg prose-img:border prose-img:border-[var(--border)]
      prose-code:text-[var(--accent-strong)] prose-code:bg-[var(--surface-3)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-hr:border-[var(--border)] prose-hr:my-10 mb-14">
      <Content />
    </div>

    <nav class="flex flex-col sm:flex-row justify-between gap-3 sm:gap-4 pt-8 border-t border-[var(--border)] text-xs font-mono">
      {prev ? (
        <a href={`/game-portfolio/games/${game.id}/devlog/${prev.data.number}/`} class="flex-1 px-4 py-3 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-heading)] transition">
          &larr; #{prev.data.number} {prev.data.title}
        </a>
      ) : <span class="flex-1" />}
      {next ? (
        <a href={`/game-portfolio/games/${game.id}/devlog/${next.data.number}/`} class="flex-1 px-4 py-3 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-heading)] transition text-left sm:text-right">
          #{next.data.number} {next.data.title} &rarr;
        </a>
      ) : <span class="flex-1" />}
    </nav>
  </article>
</Layout>
