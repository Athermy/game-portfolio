---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateRange, durationLabel } from '../../lib/format';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const allDevlogs = await getCollection('devlogs');

  return games.map((game) => {
    const devlogs = allDevlogs
      .filter((d) => d.data.game === game.id)
      .sort((a, b) => b.data.number - a.data.number); // newest first
    return {
      params: { id: game.id },
      props: { game, devlogs },
    };
  });
}

const { game, devlogs } = Astro.props;
const { Content } = await render(game);
const d = game.data;
const gallery = d.gallery || [];
const isOngoing = d.status === 'ongoing';
---

<Layout title={`${d.title} | Athermy Games`}>
  <article class="max-w-4xl mx-auto px-6 py-12 sm:py-16 w-full">
    <a href="/game-portfolio/games/" class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 hover:text-emerald-400 transition-colors mb-8">
      &larr; BACK TO GAMES
    </a>

    <!-- Logo / title / duration -->
    <header class="text-center mb-10">
      {d.logo && (
        <img src={d.logo} alt={`${d.title} logo`} class="w-28 h-28 rounded-full object-cover mx-auto mb-6 border border-white/10" />
      )}
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-2">{d.title}</h1>
      <p class="text-slate-400 text-sm sm:text-base font-light tracking-wide mb-4">{d.shortDescription}</p>
      <span class="inline-block px-3 py-1.5 rounded bg-white/[0.06] text-slate-300 text-xs font-mono">
        {durationLabel(d.startDate, d.endDate)} · {formatDateRange(d.startDate, d.endDate)}
      </span>
    </header>

    <!-- About / status / tools / skills -->
    <section class="hero-callout p-6 mb-12">
      <h2 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-3">About the Game</h2>

      <div class="flex flex-wrap items-center gap-2 mb-5">
        {isOngoing ? (
          <span class="badge badge-wip">🔧 Ongoing — actively updated</span>
        ) : d.updatesPlanned ? (
          <span class="badge badge-repo">✅ Done — more updates planned</span>
        ) : (
          <span class="badge badge-private">✅ Done — no further updates planned</span>
        )}
        <span class="badge">{d.role}</span>
        <span class="badge">{d.solo ? 'Solo' : 'Team'}</span>
      </div>

      <div class="mb-5">
        <p class="text-[11px] font-mono text-slate-500 uppercase tracking-widest mb-2">Tools Used</p>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge">{d.engine}</span>
          {d.languages.map((l) => <span class="badge">{l}</span>)}
          {d.tools.map((t) => <span class="badge">{t}</span>)}
        </div>
      </div>

      {d.skills.length > 0 && (
        <div>
          <p class="text-[11px] font-mono text-slate-500 uppercase tracking-widest mb-2">What I Did</p>
          <div class="flex flex-wrap gap-1.5">
            {d.skills.map((s) => <span class="badge badge-play">{s}</span>)}
          </div>
        </div>
      )}
    </section>

    <!-- Trailer -->
    {d.trailerUrl && (
      <section class="mb-10">
        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-3">Trailer</h3>
        <div class="rounded-xl overflow-hidden border border-white/[0.08] bg-slate-950 aspect-video">
          <iframe
            src={d.trailerUrl}
            title={`${d.title} trailer`}
            class="w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    )}

    <!-- Gallery -->
    {gallery.length > 0 && (
      <section class="mb-10">
        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-3">Gallery</h3>
        <div class="rounded-xl overflow-hidden border border-white/[0.08] bg-slate-950">
          <div class="h-80 sm:h-[450px] w-full relative">
            <img id="active-gallery-img" src={gallery[0]} alt={d.title} class="w-full h-full object-contain" />
          </div>
          {gallery.length > 1 && (
            <div class="flex items-center gap-2 p-3 bg-slate-900/60 border-t border-white/[0.06] overflow-x-auto">
              {gallery.map((imgUrl, index) => (
                <button
                  data-img-src={imgUrl}
                  class={`gallery-thumb-btn w-20 h-14 rounded overflow-hidden border transition-all shrink-0 cursor-pointer ${
                    index === 0 ? 'border-emerald-400 opacity-100' : 'border-white/10 opacity-50 hover:opacity-80'
                  }`}
                >
                  <img src={imgUrl} alt={`Thumbnail ${index + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Where to find it -->
    <section class="mb-14 flex flex-wrap gap-2">
      {d.playUrl && (
        <a href={d.playUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-play font-mono text-xs font-medium hover:opacity-80 transition">
          Play in Browser &rarr;
        </a>
      )}
      {d.downloadUrl && (
        <a href={d.downloadUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-download font-mono text-xs font-medium hover:opacity-80 transition">
          Download &rarr;
        </a>
      )}
      {d.githubUrl && !d.isPrivateRepo && (
        <a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded bg-white text-black font-mono text-xs font-medium hover:bg-slate-200 transition">
          View Source &rarr;
        </a>
      )}
      {d.isPrivateRepo && <span class="badge badge-private self-center">🔒 Source not public</span>}
    </section>

    <!-- Extended description (markdown body) -->
    <div class="prose prose-invert max-w-none
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
      prose-h2:text-2xl prose-h2:border-b prose-h2:border-white/[0.08] prose-h2:pb-3 prose-h2:mt-10
      prose-h3:text-lg prose-h3:text-emerald-400 prose-h3:mt-8
      prose-p:text-slate-300 prose-p:leading-relaxed
      prose-li:text-slate-300 prose-ul:list-disc prose-ol:list-decimal
      prose-code:text-emerald-300 prose-code:bg-white/[0.06] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-hr:border-white/[0.08] prose-hr:my-10 mb-14">
      <Content />
    </div>

    <!-- Devlog -->
    {devlogs.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-white tracking-tight mb-6 pb-3 border-b border-white/[0.08]">
          Development Blog
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {devlogs.map((log) => (
            <a
              href={`/game-portfolio/games/${game.id}/devlog/${log.data.number}/`}
              class="project-card rounded-xl overflow-hidden flex flex-col group"
            >
              {log.data.coverImage && (
                <div class="h-32 w-full bg-slate-950 overflow-hidden border-b border-white/[0.06]">
                  <img src={log.data.coverImage} alt={log.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
              )}
              <div class="p-4 flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <span class="badge">#{log.data.number}</span>
                  <h3 class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">{log.data.title}</h3>
                </div>
                <p class="text-xs text-slate-400 font-light line-clamp-2 leading-relaxed">{log.data.excerpt}</p>
                <p class="text-[10px] font-mono text-slate-600 mt-1">Published {log.data.date}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<script>
  const setupGallery = () => {
    const activeImg = document.getElementById('active-gallery-img') as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');
    if (!activeImg || !thumbBtns.length) return;
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img-src');
        if (src) {
          activeImg.src = src;
          thumbBtns.forEach((b) => {
            b.classList.remove('border-emerald-400', 'opacity-100');
            b.classList.add('border-white/10', 'opacity-50');
          });
          btn.classList.add('border-emerald-400', 'opacity-100');
          btn.classList.remove('border-white/10', 'opacity-50');
        }
      });
    });
  };
  setupGallery();
  document.addEventListener('astro:after-swap', setupGallery);
</script>
