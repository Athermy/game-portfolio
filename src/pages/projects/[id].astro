---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateRange, durationLabel } from '../../lib/format';
import { FALLBACK_IMAGE } from '../../lib/media';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const allDevlogs = await getCollection('devlogs');

  return projects.map((project) => {
    const devlogs = allDevlogs
      .filter((d) => d.data.project === project.id)
      .sort((a, b) => b.data.number - a.data.number); // newest first
    return {
      params: { id: project.id },
      props: { project, devlogs },
    };
  });
}

const { project, devlogs } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isWip = !d.endDate;
const gallery = d.gallery && d.gallery.length > 0 ? d.gallery : [FALLBACK_IMAGE];
---

<Layout title={`${d.title} | Athermy Projects`}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 w-full">
    <a href="/game-portfolio/projects/" class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-faint)] hover:text-[var(--accent)] transition-colors mb-8">
      &larr; BACK TO PROJECTS
    </a>

    <header class="border-b border-[var(--border)] pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs font-mono">
        <span class="px-2.5 py-1 rounded bg-[var(--surface-2)] text-[var(--text-secondary)] border border-[var(--border)]">{d.role}</span>
        <span class="px-2.5 py-1 rounded bg-[var(--surface-2)] text-[var(--text-muted)] border border-[var(--border)]">{d.solo ? 'Solo' : 'Team'}</span>
        {isWip && <span class="badge badge-wip">Work in Progress</span>}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--text-heading)] tracking-tight mb-3">{d.title}</h1>
      <p class="text-[11px] font-mono text-[var(--text-faint)] mb-4">
        {formatDateRange(d.startDate, d.endDate)} · {durationLabel(d.startDate, d.endDate)}
      </p>
      <p class="text-[var(--text-body)] text-base sm:text-lg leading-relaxed font-light">{d.shortDescription}</p>

      <div class="hero-callout p-4 mt-6 text-sm text-[var(--text-body)] flex items-start gap-2">
        <span class="mt-0.5">ℹ️</span>
        <span>
          Built {d.solo ? 'solo' : 'with a team'} using <strong>{d.stack.join(', ')}</strong>.
        </span>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-[var(--border)] text-xs font-mono">
        <div class="flex flex-wrap gap-2">
          {d.tags.map((tag) => <span class="text-[var(--text-faint)]">#{tag}</span>)}
        </div>

        <div class="flex flex-wrap gap-2">
          {d.playUrl && (
            <a href={d.playUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-play font-medium hover:opacity-80 transition">
              Try it &rarr;
            </a>
          )}
          {d.downloadUrl && (
            <a href={d.downloadUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-download font-medium hover:opacity-80 transition">
              Download &rarr;
            </a>
          )}
          {d.githubUrl && !d.isPrivateRepo && (
            <a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded bg-white text-black font-medium hover:bg-slate-200 transition">
              View Source &rarr;
            </a>
          )}
          {d.isPrivateRepo && <span class="badge badge-private">🔒 Private Repository</span>}
        </div>
      </div>
    </header>

    {gallery.length > 0 && (
      <section class="mb-12">
        <h3 class="text-xs font-mono text-[var(--text-faint)] uppercase tracking-widest mb-3">Gallery</h3>
        <div class="rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--bg-media)]">
          <div class="h-80 sm:h-[450px] w-full relative">
            <img id="active-gallery-img" src={gallery[0]} alt={d.title} class="w-full h-full object-contain" onerror={`this.onerror=null; this.src='${FALLBACK_IMAGE}';`} />
          </div>
          {gallery.length > 1 && (
            <div class="flex items-center gap-2 p-3 bg-[var(--bg-elevated)]/60 border-t border-[var(--border)] overflow-x-auto">
              {gallery.map((imgUrl, index) => (
                <button
                  data-img-src={imgUrl}
                  class={`gallery-thumb-btn w-20 h-14 rounded overflow-hidden border transition-all shrink-0 cursor-pointer ${
                    index === 0 ? 'border-[var(--accent)] opacity-100' : 'border-[var(--border)] opacity-50 hover:opacity-80'
                  }`}
                >
                  <img src={imgUrl} alt={`Thumbnail ${index + 1}`} class="w-full h-full object-cover" onerror={`this.onerror=null; this.src='${FALLBACK_IMAGE}';`} />
                </button>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <div class="prose prose-invert max-w-2xl mx-auto
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--text-heading)] prose-strong:text-[var(--text-heading)] prose-strong:font-semibold prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline
      prose-h2:text-2xl prose-h2:border-b prose-h2:border-[var(--border)] prose-h2:pb-3 prose-h2:mt-10
      prose-h3:text-xl prose-h3:font-bold prose-h3:text-[var(--accent)] prose-h3:mt-10 prose-h3:mb-3
      prose-p:text-[var(--text-body)] prose-p:leading-relaxed
      prose-li:text-[var(--text-secondary)] prose-ul:list-disc prose-ol:list-decimal
      prose-code:text-[var(--accent-strong)] prose-code:bg-[var(--surface-3)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-hr:border-[var(--border)] prose-hr:my-10 mb-14">
      <Content />
    </div>

    <!-- Devlog -->
    {devlogs.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-[var(--text-heading)] tracking-tight mb-6 pb-3 border-b border-[var(--border)]">
          Development Blog
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {devlogs.map((log) => (
            <a
              href={`/game-portfolio/projects/${project.id}/devlog/${log.data.number}/`}
              class="project-card rounded-xl overflow-hidden flex flex-col group"
            >
              {log.data.coverImage && (
                <div class="h-32 w-full bg-[var(--bg-media)] overflow-hidden border-b border-[var(--border)]">
                  <img src={log.data.coverImage} alt={log.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
              )}
              <div class="p-4 flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <span class="badge">#{log.data.number}</span>
                  <h3 class="text-sm font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors">{log.data.title}</h3>
                </div>
                <p class="text-xs text-[var(--text-muted)] font-light line-clamp-2 leading-relaxed">{log.data.excerpt}</p>
                {log.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {log.data.tags.map((tag) => <span class="badge">{tag}</span>)}
                  </div>
                )}
                <p class="text-[10px] font-mono text-[var(--text-faintest)] mt-1">Published {log.data.date}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<script>
  const setupGallery = () => {
    const activeImg = document.getElementById('active-gallery-img') as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');
    if (!activeImg || !thumbBtns.length) return;
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img-src');
        if (src) {
          activeImg.src = src;
          thumbBtns.forEach((b) => {
            b.classList.remove('border-[var(--accent)]', 'opacity-100');
            b.classList.add('border-[var(--border)]', 'opacity-50');
          });
          btn.classList.add('border-[var(--accent)]', 'opacity-100');
          btn.classList.remove('border-[var(--border)]', 'opacity-50');
        }
      });
    });
  };
  setupGallery();
  document.addEventListener('astro:after-swap', setupGallery);
</script>
