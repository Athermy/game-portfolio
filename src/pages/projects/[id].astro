---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateRange, durationLabel } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isWip = !d.endDate;
const gallery = d.gallery || [];
---

<Layout title={`${d.title} | Athermy Projects`}>
  <article class="max-w-4xl mx-auto px-6 py-12 sm:py-16 w-full">
    <a href="/game-portfolio/projects/" class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 hover:text-emerald-400 transition-colors mb-8">
      &larr; BACK TO PROJECTS
    </a>

    <header class="border-b border-white/[0.08] pb-8 mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs font-mono">
        <span class="px-2.5 py-1 rounded bg-white/[0.04] text-slate-300 border border-white/[0.08]">{d.role}</span>
        <span class="px-2.5 py-1 rounded bg-white/[0.04] text-slate-400 border border-white/[0.08]">{d.solo ? 'Solo' : 'Team'}</span>
        {isWip && <span class="badge badge-wip">Work in Progress</span>}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3">{d.title}</h1>
      <p class="text-[11px] font-mono text-slate-500 mb-4">
        {formatDateRange(d.startDate, d.endDate)} · {durationLabel(d.startDate, d.endDate)}
      </p>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-light">{d.shortDescription}</p>

      <div class="hero-callout p-4 mt-6 text-sm text-slate-200 flex items-start gap-2">
        <span class="mt-0.5">ℹ️</span>
        <span>
          Built {d.solo ? 'solo' : 'with a team'} using <strong>{d.stack.join(', ')}</strong>.
        </span>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-white/[0.06] text-xs font-mono">
        <div class="flex flex-wrap gap-2">
          {d.tags.map((tag) => <span class="text-slate-500">#{tag}</span>)}
        </div>

        <div class="flex flex-wrap gap-2">
          {d.playUrl && (
            <a href={d.playUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-play font-medium hover:opacity-80 transition">
              Try it &rarr;
            </a>
          )}
          {d.downloadUrl && (
            <a href={d.downloadUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded badge-download font-medium hover:opacity-80 transition">
              Download &rarr;
            </a>
          )}
          {d.githubUrl && !d.isPrivateRepo && (
            <a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded bg-white text-black font-medium hover:bg-slate-200 transition">
              View Source &rarr;
            </a>
          )}
          {d.isPrivateRepo && <span class="badge badge-private">🔒 Private Repository</span>}
        </div>
      </div>
    </header>

    {gallery.length > 0 && (
      <section class="mb-12">
        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-3">Gallery</h3>
        <div class="rounded-xl overflow-hidden border border-white/[0.08] bg-slate-950">
          <div class="h-80 sm:h-[450px] w-full relative">
            <img id="active-gallery-img" src={gallery[0]} alt={d.title} class="w-full h-full object-contain" />
          </div>
          {gallery.length > 1 && (
            <div class="flex items-center gap-2 p-3 bg-slate-900/60 border-t border-white/[0.06] overflow-x-auto">
              {gallery.map((imgUrl, index) => (
                <button
                  data-img-src={imgUrl}
                  class={`gallery-thumb-btn w-20 h-14 rounded overflow-hidden border transition-all shrink-0 cursor-pointer ${
                    index === 0 ? 'border-emerald-400 opacity-100' : 'border-white/10 opacity-50 hover:opacity-80'
                  }`}
                >
                  <img src={imgUrl} alt={`Thumbnail ${index + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <div class="prose prose-invert max-w-none
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
      prose-h2:text-2xl prose-h2:border-b prose-h2:border-white/[0.08] prose-h2:pb-3 prose-h2:mt-10
      prose-h3:text-lg prose-h3:text-emerald-400 prose-h3:mt-8
      prose-p:text-slate-300 prose-p:leading-relaxed
      prose-li:text-slate-300 prose-ul:list-disc prose-ol:list-decimal
      prose-code:text-emerald-300 prose-code:bg-white/[0.06] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-hr:border-white/[0.08] prose-hr:my-10">
      <Content />
    </div>
  </article>
</Layout>

<script>
  const setupGallery = () => {
    const activeImg = document.getElementById('active-gallery-img') as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');
    if (!activeImg || !thumbBtns.length) return;
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img-src');
        if (src) {
          activeImg.src = src;
          thumbBtns.forEach((b) => {
            b.classList.remove('border-emerald-400', 'opacity-100');
            b.classList.add('border-white/10', 'opacity-50');
          });
          btn.classList.add('border-emerald-400', 'opacity-100');
          btn.classList.remove('border-white/10', 'opacity-50');
        }
      });
    });
  };
  setupGallery();
  document.addEventListener('astro:after-swap', setupGallery);
</script>
