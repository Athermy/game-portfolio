---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDateRange, durationLabel, sortKey } from '../../lib/format';
import { FALLBACK_IMAGE } from '../../lib/media';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => sortKey(b.data.startDate) - sortKey(a.data.startDate));
---

<Layout title="Projects | Athermy">
  <div class="fixed inset-0 bg-grid-pattern pointer-events-none opacity-40 -z-10"></div>

  <section class="py-12 sm:py-16 max-w-6xl mx-auto px-4 sm:px-6 w-full flex-grow">
    <header class="mb-12 border-b border-[var(--border)] pb-10">
      <div class="flex items-center gap-3 text-xs font-mono text-[var(--accent)] mb-3 tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        ATHERMY // PROJECTS
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--text-heading)] mb-4">Projects</h1>
      <p class="text-[var(--text-secondary)] text-base sm:text-lg max-w-2xl font-light leading-relaxed">
        Tools, apps, and non-game work — infrastructure, web apps, internal utilities.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => {
        const d = project.data;
        const isWip = !d.endDate;
        return (
          <a href={`/game-portfolio/projects/${project.id}/`} class="project-card rounded-xl overflow-hidden flex flex-col group">
            <div class="h-44 w-full bg-[var(--bg-media)] relative block overflow-hidden border-b border-[var(--border)]">
              {d.videoUrl ? (
                <video src={d.videoUrl} autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" /><img src={FALLBACK_IMAGE} alt="Work in progress" class="hidden w-full h-full object-cover opacity-70" />
              ) : d.gifUrl ? (
                <img src={d.gifUrl} alt={d.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror={`this.onerror=null; this.src='${FALLBACK_IMAGE}';`} />
              ) : d.gallery && d.gallery.length > 0 ? (
                <img src={d.gallery[0]} alt={d.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror={`this.onerror=null; this.src='${FALLBACK_IMAGE}';`} />
              ) : (
                <img src={FALLBACK_IMAGE} alt="Work in progress" class="w-full h-full object-cover opacity-70" />
              )}
            </div>

            <div class="p-5 flex flex-col flex-grow gap-3">
              <div>
                <h2 class="text-lg font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors mb-1">{d.title}</h2>
                <p class="text-[11px] font-mono text-[var(--text-faint)]">{formatDateRange(d.startDate, d.endDate)} · {durationLabel(d.startDate, d.endDate)}</p>
              </div>

              <p class="text-xs text-[var(--text-muted)] font-light line-clamp-2 leading-relaxed">{d.shortDescription}</p>

              <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-[var(--border)]">
                {d.stack.map((s) => <span class="badge">{s}</span>)}
                <span class="badge">{d.solo ? 'Solo' : 'Team'}</span>
                {d.tags.map((t) => <span class="badge">{t}</span>)}
                {isWip && <span class="badge badge-wip">WIP</span>}
                {d.playUrl && <span class="badge badge-play">Playable</span>}
                {d.downloadUrl && <span class="badge badge-download">Downloadable</span>}
                {d.githubUrl && !d.isPrivateRepo && <span class="badge badge-repo">Public Repo</span>}
                {d.isPrivateRepo && <span class="badge badge-private">Private</span>}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
