---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortKey } from '../lib/format';

const games = (await getCollection('games')).sort((a, b) => sortKey(b.data.startDate) - sortKey(a.data.startDate));

// Featured-flagged games come first; if fewer than 3 are flagged, fill the
// remaining slots with the next most recent games so the section always
// shows up to 3 (never fewer just because you haven't flagged enough).
const flagged = games.filter((g) => g.data.featured);
const fillers = games.filter((g) => !g.data.featured);
const highlighted = [...flagged, ...fillers].slice(0, 3);

// Optional hero background image — drop a wide (1920x1080+) screenshot or
// piece of key art here. Leave empty to fall back to the plain dark/grid look.
const heroImage = '';

const icons = {
  github:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.2 9.2 0 0 1 2.5-.35c.85 0 1.71.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.27 10.27 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>',
  itch:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M3 7l2-4h14l2 4M8 13a2 2 0 0 1-4 0M12 13a2 2 0 0 1-4 0M16 13a2 2 0 0 1-4 0M20 13a2 2 0 0 1-4 0"/></svg>',
  email:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 7 8-7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};

const socials = [
  { label: 'GitHub', url: 'https://github.com/Athermy', icon: icons.github },
  { label: 'itch.io', url: 'https://athermy.itch.io', icon: icons.itch },
  { label: 'Email', url: 'mailto:hello@athermy.dev', icon: icons.email },
];
---

<Layout title="Athermy | Game Systems & Architecture">
  <!-- Hero: full viewport height -->
  <section class="relative min-h-screen w-full flex flex-col items-center justify-center text-center overflow-hidden">
    {heroImage ? (
      <img src={heroImage} alt="" class="absolute inset-0 w-full h-full object-cover" />
    ) : (
      <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
    )}
    <!-- Dark gradient overlay so text stays readable over any background -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-[#0a0c10]"></div>

    <div class="relative z-10 px-6">
      <div class="flex items-center justify-center gap-3 text-xs font-mono text-emerald-400 mb-4 tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        ATHERMY
      </div>
      <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight text-white mb-3">
        Hi, I'm Athermy
      </h1>
      <p class="text-slate-300 text-lg sm:text-xl font-light tracking-wide mb-12">
        I'm a Game Developer!
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/game-portfolio/games/" class="px-5 py-2.5 rounded-full border border-white/25 text-white text-xs font-mono tracking-wide hover:bg-white hover:text-black transition">
          GAMES
        </a>
        <a href="/game-portfolio/projects/" class="px-5 py-2.5 rounded-full border border-white/25 text-white text-xs font-mono tracking-wide hover:bg-white hover:text-black transition">
          PROJECTS
        </a>
      </div>
    </div>

    <!-- Scroll-down hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 text-slate-500 animate-bounce">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </section>

  <div class="fixed inset-0 bg-grid-pattern pointer-events-none opacity-40 -z-10"></div>

  <!-- Highlighted games (max 3) -->
  {highlighted.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-20 w-full">
      <h2 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-6 text-center">Highlighted Games</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {highlighted.map((game) => (
          <a href={`/game-portfolio/games/${game.id}/`} class="project-card rounded-xl overflow-hidden flex flex-col group">
            <div class="h-44 w-full bg-slate-950 relative overflow-hidden border-b border-white/[0.06]">
              {game.data.videoUrl ? (
                <video src={game.data.videoUrl} autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              ) : game.data.gifUrl ? (
                <img src={game.data.gifUrl} alt={game.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              ) : (
                <div class="w-full h-full flex items-center justify-center font-mono text-[11px] text-slate-600">[NO PREVIEW MEDIA]</div>
              )}
            </div>
            <div class="p-5">
              <span class="text-[10px] font-mono text-emerald-400">{game.data.engine}</span>
              <h3 class="text-lg font-semibold text-white group-hover:text-emerald-400 transition-colors mt-1 mb-2">
                {game.data.title}
              </h3>
              <p class="text-xs text-slate-400 font-light line-clamp-2 leading-relaxed">{game.data.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- About me (bottom of page) -->
  <section class="border-t border-white/[0.06] bg-white/[0.02]">
    <div class="max-w-3xl mx-auto px-6 py-16 text-center">
      <h2 class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-6">About Me</h2>
      <p class="text-slate-300 text-base sm:text-lg font-light leading-relaxed">
        Hi! I'm Athermy, a solo developer based in France. I like picking apart how games
        are put together as much as making them — engines, tooling, and the small systems
        underneath a project are usually where I end up spending my time. I'm always looking
        for an excuse to learn something new, whether that's a new engine, (something else).
      </p>

      <div class="flex flex-wrap justify-center gap-6 text-xs font-mono text-slate-500 mt-8">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-emerald-400 transition-colors">
            <span set:html={s.icon} />
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
